# ============================================================
# 本地开发环境变量模板
# 复制为 .env.local 后按需修改（.env.local 已被 .gitignore 排除）
#
# 使用说明：
#   1. JWT_SIGNING_KEY / INTERNAL_SECRET 为必填项（>= 32 字节），
#      缺失或过短将导致服务拒绝启动（与 pkg/confx 启动校验一致）
#   2. 三个服务（platform / gamelogic / gmt）共享本环境变量文件，
#      服务间地址与共享密钥必须保持一致
#   3. 预留空的变量保持原样即可；带 # 前缀的行为可选配置，取消注释后生效
# ============================================================

# -------------------- 通用配置 --------------------
# 运行环境标识：local / dev / staging / prod，默认 local
APP_ENV=local
# 配置文件目录（加载 configs/{service}_{env}.yaml），默认 configs
CONFIG_DIR=configs

# -------------------- 基础设施：MongoDB --------------------
# MongoDB 连接地址（三个服务共用同一实例），默认 mongodb://localhost:27017
# 对应各服务配置文件 configs/{service}_{env}.yaml 的 mongo.uri（本地基线），二者为同一配置键的两层来源；
# 本变量非空时优先于 YAML 生效（整体优先级：环境变量 > 配置文件 > 代码默认值）。
# 本地开发若希望以 YAML 为唯一来源，可把此变量留空
MONGO_URI=mongodb://localhost:27017
# 业务库名（可选）：各服务默认库名分别为 platform_db / logic_db / gmt_db。
# 对应各配置文件 mongo.database 项；注意：MONGO_DATABASE 为全局变量，
# 设置后会同时覆盖全部服务的默认库名，如需逐服务区分请改在各配置文件的 mongo.database 中设置
# MONGO_DATABASE=
# 游戏全局配置库名（platform / gamelogic / gmt 共享），默认 gconfig_db，
# 该键由代码 confx.GetEnv 独立读取，无对应 YAML 键，仅能通过环境变量设置
CONFIG_MONGO_DATABASE=gconfig_db

# -------------------- 基础设施：Redis --------------------
# Redis 连接地址（三个服务共用同一实例），默认 localhost:6379
# 对应各服务配置文件 redis.addr（本地基线），本变量非空时优先于 YAML 生效
REDIS_ADDR=localhost:6379
# Redis 密码，无密码则留空；对应各配置文件 redis.password（该键仅支持环境变量方式设置）
REDIS_PASSWORD=
# Redis 逻辑库编号，默认 0；对应各配置文件 redis.db（该键仅支持环境变量方式设置）
REDIS_DB=0

# -------------------- JWT 与内部签名密钥（必填）--------------------
# JWT 签名密钥：全部服务必须一致；小于 32 字节或弱口令将拒绝启动。
# 本地演练示例：# JWT_SIGNING_KEY=local-dev-only-jwt-secret-0123456789abcdef
JWT_SIGNING_KEY=local-dev-only-jwt-secret-0123456789abcdef
# 内部服务间验签密钥：Platform / GameLogic / GMT 必须完全一致；要求同 JWT_SIGNING_KEY
# 本地演练示例：# INTERNAL_SECRET=local-dev-internal-secret-0123456789abcdef
INTERNAL_SECRET=local-dev-internal-secret-0123456789abcdef

# -------------------- 三方接口签名密钥 --------------------
# 三方充值回调与 LunPlay 角色查询等三方平台接口共用的密钥（Platform 服务使用）：
# 未配置（留空）时对应接口拒绝全部请求
THIRD_PARTY_KEY=

# -------------------- 服务间地址 --------------------
# Platform 服务地址（GameLogic / GMT 调用用）
PLATFORM_URL=http://localhost:8080
# GameLogic 服务地址（Platform 支付回调 / GMT 调用用）
GAMELOGIC_URL=http://localhost:8081

# -------------------- 服务端口（可选）--------------------
# 默认端口：Platform 8080 / GameLogic 8081 / GMT 8082（各服务配置文件 server.port 中指定）
# 注意：SERVER_PORT 为全局变量，会同时覆盖全部服务端口，一般不建议在环境变量中设置
# SERVER_PORT=

# -------------------- 日志（可选）--------------------
# 日志文件目录，默认 ./logs
# LOG_DIR=./logs
# 日志级别：debug / info / warn / error，默认 debug
# LOG_LEVEL=debug
# 是否同时输出到控制台，默认 true
# LOG_CONSOLE=true
# 单个日志文件大小上限（MB），写满即轮转，默认 200
# LOG_MAX_SIZE=200
# 历史日志保留天数，超期自动删除，默认 7
# LOG_MAX_AGE=7
# 历史日志份数上限，0 表示不按份数限制（默认 0，保留策略只由 LOG_MAX_AGE 决定）
# LOG_MAX_BACKUPS=0
# 是否压缩历史日志，默认 true（注意为轮转时即压缩，非「延迟 N 天再压缩」）
# LOG_COMPRESS=true

# -------------------- GameLogic 反代信任（可选）--------------------
# 信任的反代 IP / CIDR 列表（逗号分隔，如 "127.0.0.1,10.0.0.0/8"），
# 配置后从 X-Forwarded-For 读取真实客户端 IP（用于限流等场景）
# TRUSTED_PROXIES=

# -------------------- GMT 管理后台跨域来源 --------------------
# 允许跨域访问的前端来源白名单（逗号分隔）
# 留空表示不开放任何跨域来源；生产环境必须显式配置可信前端域名，禁止使用 *
GMT_CORS_ALLOWED_ORIGINS=

# -------------------- GMT 前端页面托管（可选）--------------------
# Vue 前端打包后的静态文件目录（如 ./webadmin/dist）。
# 配置后 GMT 直接托管后台页面（支持 SPA history 回退），留空则不启用静态托管
# GMT_WEB_DIST=
# 可选：后台 API 反向代理目标地址（如 http://localhost:8082）。
# 留空时 /api 请求由同端口 GMT 路由处理（同源集成）；配置后 /api 请求转发到该目标
# GMT_WEB_PROXY_TARGET=

# -------------------- GMT 超管初始化（可选）--------------------
# 仅首次启动时生效，账号已存在则跳过；用户名与密码必须成对提供
# 密码要求：>= 12 位，包含大写、小写、数字、特殊字符
# 不填则不自动创建超管，需自行通过其他方式初始化
GMT_BOOTSTRAP_ADMIN_USERNAME=admin
GMT_BOOTSTRAP_ADMIN_PASSWORD=Admin123456!
GMT_BOOTSTRAP_ADMIN_NICKNAME=超级管理员

# -------------------- 测试专用（可选）--------------------
# tests/login_test.go 集成测试：待测服务基础地址
# TEST_BASE_URL=http://localhost:8080
# pkg/mongox 单元测试：MongoDB 连接地址
# MONGO_TEST_URI=mongodb://localhost:27017